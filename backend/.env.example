# ===== Server =====
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# ===== Database =====
MONGO_URI=mongodb://127.0.0.1:27017/portfolio_platform

# ===== JWT =====
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECRET=change_this_cookie_secret

# ===== Cloudinary (optional - falls back to local uploads) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== SMTP (optional - contact notifications) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portfolio <no-reply@portfolio.dev>"
ADMIN_NOTIFY_EMAIL=admin@portfolio.dev

# ===== Seed Admin =====
SEED_ADMIN_NAME=Site Admin
SEED_ADMIN_EMAIL=admin@portfolio.dev
SEED_ADMIN_PASSWORD=Admin@12345

# ===== Rate limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
